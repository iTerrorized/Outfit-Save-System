/* OutfitSaveGenerator.uss */

.main-root {
    padding: 10px;
    flex-grow: 1;
}

.banner-box {
    border-radius: 8px;
    overflow: hidden;
    width: 100%;
    height: 120px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: stretch-to-fill;
}

.banner-text {
    width: 50%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    margin: 5px 0 10px 0;
}

.content-container {
    margin-top: 10px;
    flex-grow: 1;
}

.section {
    margin-bottom: 10px;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 5px;
}

.section-label {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.primary-button {
    height: 30px;
    margin-top: 10px;
    background-color: rgb(78, 133, 140);
    border-radius: 5px;
    color: white;
    -unity-font-style: bold;
    border-width: 0;
}

.primary-button:hover {
    background-color: rgb(90, 154, 170);
}

.primary-button:active {
    background-color: rgb(70, 104, 120);
}

.primary-button:disabled {
    background-color: rgb(60, 60, 60);
    color: rgba(255, 255, 255, 0.4);
}

.danger-button {
    height: 24px;
    background-color: rgb(140, 50, 50);
    border-radius: 3px;
    color: white;
    -unity-font-style: bold;
    border-width: 0;
    padding: 0 8px;
}

.danger-button:hover {
    background-color: rgb(170, 60, 60);
}

.danger-button:active {
    background-color: rgb(120, 40, 40);
}

.small-button {
    height: 24px;
    background-color: rgb(70, 70, 70);
    border-radius: 3px;
    color: white;
    border-width: 0;
    padding: 0 8px;
}

.small-button:hover {
    background-color: rgb(90, 90, 90);
}

.small-button:active {
    background-color: rgb(55, 55, 55);
}

/* Parameter rows */
.param-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.param-header-name {
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
}

.param-header-save {
    width: 50px;
    margin-right: 8px;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
}

.param-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.param-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.param-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.param-save {
    width: 50px;
    margin-right: 8px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.param-save > .unity-toggle__input {
    flex-grow: 0;
    align-self: center;
}

/* Save slot rows */
.slot-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0.1);
    border-radius: 3px;
    margin-bottom: 4px;
}

.slot-name {
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 12px;
}

.slot-info {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    margin-right: 8px;
}

.slot-buttons {
    flex-direction: row;
}

.slot-buttons > Button {
    margin-left: 4px;
}

/* Warning and info boxes */
.warning-box {
    background-color: rgba(200, 150, 0, 0.15);
    border-radius: 3px;
    padding: 8px;
    margin: 5px 0;
}

.warning-text {
    color: rgb(255, 200, 50);
    font-size: 11px;
    white-space: normal;
}

.error-box {
    background-color: rgba(200, 50, 50, 0.15);
    border-radius: 3px;
    padding: 8px;
    margin: 5px 0;
}

.error-text {
    color: rgb(255, 100, 100);
    font-size: 11px;
    white-space: normal;
}

.info-box {
    background-color: rgba(78, 133, 140, 0.15);
    border-radius: 3px;
    padding: 8px;
    margin: 5px 0;
}

.info-text {
    color: rgb(130, 200, 210);
    font-size: 11px;
    white-space: normal;
}

/* License section */
.license-field {
    margin-top: 5px;
}

.license-status {
    margin-top: 5px;
    font-size: 11px;
    white-space: normal;
}

/* Footer */
.footer {
    margin-top: 10px;
    height: 30px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.2);
    padding-top: 5px;
    background-color: rgba(0, 0, 0, 0.1);
}

.footer-content {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 8px;
}

.menu-button {
    width: 26px;
    height: 22px;
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-right: 4px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(255, 255, 255, 0.6);
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
}

.version-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.4);
    width: 40px;
}

.author-label {
    -unity-text-align: middle-right;
    -unity-font-style: italic;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}
